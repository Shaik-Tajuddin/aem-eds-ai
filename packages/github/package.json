{
  "name": "@aeds/github",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub adapter for AI EDS Developer â€” clone, branch, read, write, PR",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },

  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aeds/shared": "*",
    "@octokit/rest": "^21.1.1",
    "simple-git": "^3.28.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "rimraf": "^6.0.1"
  }
}
