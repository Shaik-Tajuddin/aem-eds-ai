{
  "name": "@aeds/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL database schema, migrations, and client for AI EDS Developer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "npx tsx scripts/baseline-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/jwt": "10.2.2",
    "@fastify/swagger-ui": "6.1.1",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "node-cron": "4.6.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.6",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@aeds/shared": "*"
  }
}
