# ===================================
# AI EDS Developer — Environment Variables
# ===================================
# Copy this file to .env.local (apps/web) and .env (apps/api)
# NEVER commit real credentials to Git

# ─── DATABASE ─────────────────────────────────────────────
DATABASE_URL=postgresql://aeds:aeds_password@localhost:5432/aeds_dev
DATABASE_POOL_SIZE=10

# ─── REDIS ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=aeds:

# ─── OBJECT STORAGE (MinIO / S3-compatible) ───────────────
# STORAGE_URL is an alias accepted by docs; S3_ENDPOINT is the runtime key
STORAGE_URL=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aeds-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ─── AUTH (NextAuth.js) ───────────────────────────────────
# GitHub OAuth — create at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ─── API ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
API_SECRET_KEY=generate_a_strong_random_secret_here
API_PORT=3001
API_HOST=0.0.0.0

# ─── GITHUB INTEGRATION ───────────────────────────────────
# Personal Access Token (or App) with: repo, workflow, read:org
# Per-project tokens are stored encrypted in the database
GITHUB_TOKEN=ghp_your_token_here

# ─── FIGMA ────────────────────────────────────────────────
# https://www.figma.com/developers/api#access-tokens
# Per-project tokens are stored encrypted in the database
FIGMA_TOKEN=your_figma_personal_access_token_here

# ─── AEM / ADOBE IMS ──────────────────────────────────────
# Per-project credentials are stored encrypted in the database
# AEM_AUTHOR_URL and AEM_DEFAULT_AUTHORING_PATH also prefill New Project wizard
AEM_AUTHOR_URL=https://author-pXXXX-eYYYY.adobeaemcloud.com
AEM_CLIENT_ID=your_aem_client_id_here
AEM_CLIENT_SECRET=your_aem_client_secret_here
AEM_ORG_ID=your_ims_org_id_here
AEM_ORGANIZATION_ID=your_ims_org_id_here
AEM_TECHNICAL_ACCOUNT_ID=your_technical_account_id_here
AEM_PRIVATE_KEY_PATH=/path/to/private.key
AEM_DEFAULT_AUTHORING_PATH=/content/mysite/us/en
# After successful GitHub PR, optionally call aem.previewPage (never invents PASS)
ENABLE_AEM_PREVIEW=false
# Optional: Adobe Content MCP OAuth token (from Cursor aem-cloud MCP login). Prefer this for structured page content.
# AEM_MCP_ACCESS_TOKEN=
# Read-only default for agent capture; Track B write uses AEM_MCP_WRITE_URL when set
# AEM_MCP_URL=https://mcp.adobeaemcloud.com/adobe/mcp/content-readonly
# Full read/write MCP endpoint for POST /api/parity (write-api)
# AEM_MCP_WRITE_URL=https://mcp.adobeaemcloud.com/adobe/mcp/aem
# Optional direct author JWT (raw token, no "Bearer " prefix)
# AEM_BEARER_TOKEN=

# ─── CLOUD MANAGER (feature-flagged adapter) ──────────────
CLOUD_MANAGER_CLIENT_ID=
CLOUD_MANAGER_CLIENT_SECRET=
CLOUD_MANAGER_ORG_ID=
ENABLE_CLOUD_MANAGER=false

# ─── LLM (default / fallback provider) ───────────────────
# Per-project LLM config is stored encrypted in the database
# Also used as New Project wizard defaults (provider, URL, model, key)
# Providers: openai | anthropic | gemini | azure-openai | ollama | openai-compatible | custom
LLM_PROVIDER=ollama
LLM_API_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3.3
EMBEDDING_MODEL=nomic-embed-text
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1
# Azure OpenAI (when LLM_PROVIDER=azure-openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Log full LLM request messages + response content to the API/worker console (and run timeline excerpts)
LLM_DEBUG=false
# Per-block chunk sizes (smaller = faster LLM turns)
LLM_CHUNK_HTML_CHARS=4500
LLM_CHUNK_CSS_CHARS=1800
LLM_CHUNK_JS_CHARS=600
LLM_CHUNK_MAX_TOKENS=2500
LLM_CHUNK_JSON_RETRIES=6
LLM_CHUNK_JSON_RETRIES_FIRST=12
LLM_CHUNK_RETRY_DELAY_MS=1200

# ─── ENCRYPTION ───────────────────────────────────────────
# 32-byte hex key for encrypting stored secrets
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ─── OBSERVABILITY ────────────────────────────────────────
LOG_LEVEL=info
OTEL_SERVICE_NAME=ai-eds-developer-api
OTEL_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── PLAYWRIGHT ───────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SLOWMO_MS=0
ENABLE_LIVE_VISUAL=false
ENABLE_LIVE_BROWSER=
# Wait after preview branch commit so aem.live can pick up code before Playwright
PREVIEW_READY_WAIT_MS=8000
# Set true only to force live audits against unpublished speculative preview URLs
LIVE_BROWSER_ALLOW_UNPUBLISHED=false
VISUAL_BASELINE_URL=
ENABLE_LIVE_UE=false
ENABLE_LIVE_UE_AUTHORING=false
UE_STORAGE_STATE_PATH=
UE_EDITOR_URL=
# Optional Playwright selectors for tenant-specific UE chrome
UE_FIELD_SELECTOR=
UE_SAVE_SELECTOR=
UE_CHROME_SELECTOR=
UE_LOGIN_HINTS=sign in,adobe id,log in
UE_CONTENT_PAGE_URL=
ENABLE_UE_CONTENT_VERIFY=
ENABLE_LIGHTHOUSE=false
ENABLE_GITHUB_MERGE=false

# ─── AGENT LIMITS ─────────────────────────────────────────
# Also used as New Project wizard defaults
AGENT_MAX_RUNTIME_MINUTES=30
AGENT_MAX_FIX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=250
AGENT_MAX_LLM_CALLS=100
AGENT_MAX_ESTIMATED_COST_USD=

# ─── QUALITY GATE DEFAULTS ────────────────────────────────
# Also used as New Project wizard defaults
QG_VISUAL_THRESHOLD=95
QG_ACCESSIBILITY_THRESHOLD=95
QG_PERFORMANCE_THRESHOLD=90
