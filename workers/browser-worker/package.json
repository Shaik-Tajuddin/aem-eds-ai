{
  "name": "@aeds/browser-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright browser test and visual diff BullMQ worker for AI EDS Developer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aeds/browser": "*",
    "@aeds/database": "*",
    "@aeds/queue": "*",
    "@aeds/shared": "*",
    "@aeds/visual": "*",
    "bullmq": "^5.56.2",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
